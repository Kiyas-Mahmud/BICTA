{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bicta",
  // Nitro's cloudflare_module preset emits the Worker entry + static assets here.
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-20",
  // bcryptjs, qrcode and sanitize-html reach for node builtins (crypto, stream, zlib).
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  // Serve only on the custom domain. workers_dev:false retires the
  // bicta.<subdomain>.workers.dev URL so the site has exactly one address —
  // PUBLIC_SITE_URL is what every emailed link and invite link is built from,
  // so the two must always name the same host.
  "workers_dev": false,

  "vars": {
    "PUBLIC_SITE_URL": "https://bytearo.online",
    "MAIL_FROM": "BICTA <no-reply@bytearo.online>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bicta",
      "database_id": "78b3f77f-f4de-4ebc-b0c5-2a620f32c24e",
      // Drizzle Kit writes numbered .sql files here; wrangler applies them in order.
      "migrations_dir": "./server/database/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "bicta-uploads"
    }
  ],

  // Hourly sweep that releases selection results whose announcement date has
  // arrived (server/plugins/scheduled.ts). Hourly rather than by-the-minute
  // because the schedule is a date, not a time of day.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
