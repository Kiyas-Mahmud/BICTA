{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keeps the existing Worker: its GitHub build connection, secrets
  // (NUXT_SESSION_PASSWORD, RESEND_API_KEY) and cron trigger all live on this
  // name. Only the bindings and domain move. The name is never user-visible
  // once workers_dev is off.
  "name": "bicta",
  // Nitro's cloudflare_module preset emits the Worker entry + static assets here.
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-20",
  // bcryptjs, qrcode and sanitize-html reach for node builtins (crypto, stream, zlib).
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  // One address only. bytearo.online keeps serving until bicta.net is
  // attached, so there is no need for a workers.dev fallback in between.
  "workers_dev": false,

  // Custom domain. Declaring it here (rather than clicking it in the
  // dashboard) means the GitHub build owns it, so a redeploy can never
  // silently drop it.
  //
  // bicta.net is delegated to Cloudflare and Active, so the zone resolves and
  // this is safe to declare. Listing it here means a redeploy re-asserts the
  // domain instead of being able to silently drop it.
  "routes": [{ "pattern": "bicta.net", "custom_domain": true }],

  "vars": {
    "PUBLIC_SITE_URL": "https://bicta.net",
    "MAIL_FROM": "BICTA <no-reply@bicta.net>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bicta-net",
      "database_id": "498cf7cd-009f-429b-8292-5a1e542cdd76",
      // Drizzle Kit writes numbered .sql files here; wrangler applies them in order.
      "migrations_dir": "./server/database/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "bicta-net-uploads"
    }
  ],

  // Hourly sweep that releases selection results whose announcement date has
  // arrived (server/plugins/scheduled.ts). Hourly rather than by-the-minute
  // because the schedule is a date, not a time of day.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
